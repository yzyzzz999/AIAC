# .env.example
# 人脸识别服务环境变量配置（复制为 .env 使用）

# ── 设备 ──
# DEVICE=cuda  → 全部使用 GPU（默认，匹配 Jetson AGX Orin）
# DEVICE=cpu   → 全部使用 CPU
DEVICE=cuda

# 可选：独立覆盖各后端设备（注释掉则自动从 DEVICE 派生）
# ORT_PROVIDERS=CUDAExecutionProvider
# DETECTOR_CTX_ID=0
# GENDER_AGE_DEVICE=gpu
# GENDER_AGE_ORT_PROVIDERS=CUDAExecutionProvider

# ── 服务 ──
HOST=0.0.0.0
PORT=7860
GALLERY_FILE=./data/gallery.pkl
UVICORN_WORKERS=1
AUTO_OPEN_BROWSER=1
# 部署模式（1/true）：仅开放 /health /stats /recognition/stop /recognition/resume
DEPLOYMENT_MODE=0

# ── 日志 ──
# debug / info / warning / error
LOG_LEVEL=info

# ── 摄像头 ──
# 设备 ID（0=默认，6=Jetson 板载），或视频文件路径
# 留空表示仅图片识别模式（不启动实时视频流）
CAMERA_ID=

# ── 人脸检测 ──
DETECTOR_SIZE=640
DETECTOR_MIN_SCORE=0
CLOTH_MODEL_PATH=./models/cloth/last.pt

# ── 识别 ──
SIM_THRESHOLD=0.40
SMOOTH_WINDOW=50
POSITIONLESS=true
AUTO_ENROLL=true

# ── 性别年龄 ──
ENABLE_GENDER_AGE=1
GENDER_AGE_BACKEND=onnx
GENDER_AGE_INTERVAL=30
GENDER_AGE_ONNX_MODEL=./models/flip-base-32/gender_age_image_encoder.onnx
GENDER_AGE_TEXT_FEATURES=./models/flip-base-32/gender_age_text_features.npz

# 稳定性阈值（用于锁定年龄/性别后跳过推理）
STABLE_REFRESH_INTERVAL=300
AGE_STABLE_WINDOW=12
AGE_STABLE_MIN_COUNT=8
AGE_STABLE_MIN_RATIO=0.60
AGE_STABLE_MIN_SCORE=0.35
GENDER_STABLE_WINDOW=20
GENDER_STABLE_MIN_COUNT=18
GENDER_STABLE_MIN_RATIO=0.85

# ── 身高估计 ──
HEIGHT_MODELS_DIR=./models/height
HEIGHT_SEAT_DX=0.62
HEIGHT_SEAT_DY=0.26
HEIGHT_SEAT_PX=0.41
HEIGHT_SEAT_PY=0.59

# ── 视频处理 ──
VIDEO_JOB_TTL=3600
